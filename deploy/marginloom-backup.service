[Unit]
Description=Marginloom SQLite online backup
After=marginloom.service

[Service]
Type=oneshot
User=marginloom
Group=marginloom
EnvironmentFile=/etc/marginloom/environment
ExecStart=/opt/marginloom/current/runtime/node /opt/marginloom/current/server/backup.mjs
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/marginloom
MemoryMax=96M
